<?xml version="1.0" encoding="utf-8"?>
<!-- Sparse MSIX package that surfaces "Open kitty here" in the Windows 11
     modern context menu via the IExplorerCommand in kitty_shell_ext.dll.
     Packed and signed by make-shellext.sh; registered by the installer with
     Add-AppxPackage -ExternalLocation <install dir>. -->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
    xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
    xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
    IgnorableNamespaces="uap uap10 rescap desktop4 desktop5 com">

  <Identity Name="Ecstra.Kitty.ContextMenu" ProcessorArchitecture="x64"
            Publisher="CN=kitty-windows-port" Version="@VERSION@" />

  <Properties>
    <DisplayName>kitty context menu</DisplayName>
    <PublisherDisplayName>kitty Windows port</PublisherDisplayName>
    <Logo>Assets\kitty150.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="kitty" Executable="kitty\launcher\kitty.exe"
                 uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements DisplayName="kitty" Description="kitty terminal"
          BackgroundColor="transparent"
          Square150x150Logo="Assets\kitty150.png" Square44x44Logo="Assets\kitty44.png"
          AppListEntry="none" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="OpenKitty" Clsid="B9AC5C9C-51D5-4A50-A806-B7EEDB1D7BDA" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="OpenKittyBg" Clsid="B9AC5C9C-51D5-4A50-A806-B7EEDB1D7BDA" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="kitty shell extension">
              <com:Class Id="B9AC5C9C-51D5-4A50-A806-B7EEDB1D7BDA" Path="shellext\kitty_shell_ext.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
